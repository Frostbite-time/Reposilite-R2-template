# 复制为 .env 后填写。注意：值不要加引号，也不要在行尾写注释。

# ================= 必填 =================

# Cloudflare 账户 ID（R2 概览页右侧可以看到）
R2_ACCOUNT_ID=

# R2 API 令牌（权限：对象读和写）创建后显示的两个值
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 存放构件的 R2 存储桶，需要事先在 Cloudflare 创建
R2_BUCKET=

# 管理员密钥，用来登录网页。可以用 openssl rand -hex 24 生成
REPOSILITE_ADMIN_SECRET=

# Cloudflare「账户分析：读取」令牌，免费额度保护用它核对用量
# 不需要额度保护的话，把下面的 R2_QUOTA_ENABLED 改成 false，这里就可以留空
CF_R2_ANALYTICS_TOKEN=

# 你的 Cloudflare 账单日（每月几号开始新的账单周期），额度在这一天重置
R2_QUOTA_BILLING_DAY=1

# ================= 免费额度保护（一般不用改） =================

R2_QUOTA_ENABLED=true

# 每个账单周期最多允许的请求次数，默认是免费额度的 90%
# A 类：上传、列出目录等（免费 100 万次）；B 类：下载、查询文件信息等（免费 1000 万次）
# 设为 0 表示完全禁止这类请求
R2_QUOTA_CLASS_A_LIMIT=900000
R2_QUOTA_CLASS_B_LIMIT=9000000

# 账单日按哪个时区计算
R2_QUOTA_BILLING_TIMEZONE=UTC

# ================= 可选（取消注释后修改） =================

# 管理员登录名
# REPOSILITE_ADMIN_NAME=admin

# 对外端口；只给本机的反向代理使用时写成 127.0.0.1:8080
# REPOSILITE_PORT=8080

# 仓库列表，用逗号分隔，格式为 名称[:public|hidden|private]
# REPOSILITE_REPOSITORIES=releases,snapshots,private:private

# 让所有文件放在桶里的某个目录下，和其他服务共用一个桶时使用，例如 maven
# R2_PREFIX=

# R2 接口地址，默认是 https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# 欧盟辖区的桶要改成 https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=

# JVM 参数。构件默认缓存 1 天，可以追加 -Dreposilite.maven.maxAge=<秒> 修改
# JAVA_OPTS=-Xmx256m

# Reposilite 版本，修改后要用 docker compose up -d --build 重新构建
# REPOSILITE_VERSION=3.6.3

# ================= 额度保护的高级选项（很少需要改） =================

# 从文件读取账户分析令牌，优先于 CF_R2_ANALYTICS_TOKEN
# CF_R2_ANALYTICS_TOKEN_FILE=/run/secrets/r2-analytics-token

# 是否每天自动和 Cloudflare 核对用量，以及核对间隔（秒）。核对失败会每分钟重试
# R2_QUOTA_SYNC_ENABLED=true
# R2_QUOTA_SYNC_INTERVAL_SECONDS=86400

# 核对时不看最近这段时间（秒）的数据，因为 Cloudflare 的统计可能还没更新完
# R2_QUOTA_SYNC_LAG_SECONDS=300

# 每个账单周期开始时，是否必须先核对一次才允许访问 R2（默认与自动核对的设置相同）
# R2_QUOTA_REQUIRE_INITIAL_SYNC=true

# 用量记录的存放位置，必须在 /app/data 下（数据卷内）
# R2_QUOTA_DB=/app/data/r2-quota/quota.db
