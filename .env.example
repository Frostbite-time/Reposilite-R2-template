# 复制为 .env 后填写。注意：值不要加引号，也不要在行尾写注释。

# ================= 必填 =================

# Cloudflare 账户 ID（R2 概览页右侧可见）
R2_ACCOUNT_ID=

# R2 API 令牌：权限选「对象读和写」，并指定到下面的桶
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 事先在 R2 控制台创建好的桶，所有仓库共用，按仓库名分目录
R2_BUCKET=

# 管理员令牌密钥（登录网页 / 管理用），建议用 openssl rand -hex 24 生成
REPOSILITE_ADMIN_SECRET=

# ================= 可选（取消注释后修改） =================

# 管理员令牌名
# REPOSILITE_ADMIN_NAME=admin

# 宿主机端口；只给本机反向代理访问时可写成 127.0.0.1:8080
# REPOSILITE_PORT=8080

# 仓库列表，逗号分隔，格式 名称[:public|hidden|private]
# REPOSILITE_REPOSITORIES=releases,snapshots,private:private

# 桶内对象前缀，与其他服务共用一个桶时使用，如 maven
# R2_PREFIX=

# 自定义 S3 端点，默认 https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# 欧盟辖区的桶：https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=

# JVM 参数；构件缓存时间默认 1 天，可追加 -Dreposilite.maven.maxAge=<秒> 修改
# JAVA_OPTS=-Xmx256m

# Reposilite 版本，修改后执行 docker compose up -d --build
# REPOSILITE_VERSION=3.6.3

# ================= R2 月度操作额度墙 =================

# 默认启用；0 表示该类调用全部拒绝。调整后 docker compose up -d 即可生效。
R2_QUOTA_ENABLED=true
R2_QUOTA_CLASS_A_LIMIT=900000
R2_QUOTA_CLASS_B_LIMIT=9000000

# 必须对齐 Cloudflare 的实际 R2 计费周期；每月该日期的本地午夜重置。
# 29/30/31 在不足该天数的月份按月末计算。
R2_QUOTA_BILLING_DAY=1
R2_QUOTA_BILLING_TIMEZONE=UTC

# 独立 Cloudflare API Token：当前账户的 Account Analytics → Read。
# 此密钥用于 GraphQL 统计，不能用上面的 R2 S3 访问密钥代替。
CF_R2_ANALYTICS_TOKEN=
# 也可从容器内已挂载的文件读取，优先于上述变量。
# CF_R2_ANALYTICS_TOKEN_FILE=/run/secrets/r2-analytics-token

# 启动时检查是否需要同步，之后每 24 小时校准一次；失败会每分钟重试。
# R2_QUOTA_SYNC_ENABLED=true
# R2_QUOTA_SYNC_INTERVAL_SECONDS=86400
# 查询截止到当前时间前 5 分钟，仅用于减少近期数据不完整的影响，并非 CF 延迟保证。
# R2_QUOTA_SYNC_LAG_SECONDS=300

# 每个新计费周期必须先同步本期云端用量，之后才允许产生计费调用。
# 首次同步失败时仍可打开网页，但 R2 A/B 调用被阻止。
# R2_QUOTA_REQUIRE_INITIAL_SYNC=true
# 台账必须放在持久化目录；不要删除或切换路径，否则会丢失本地历史。
# R2_QUOTA_DB=/app/data/r2-quota/quota.db
